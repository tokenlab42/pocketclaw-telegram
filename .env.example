# WhatsApp Business Cloud API (channelType: whatsapp-cloud)
# Settings → Basic for App Secret, System Users → generate token for Access Token,
# Phone Number ID from the API Setup panel, Verify Token is any string you choose
# and re-enter when configuring the webhook callback URL in Meta's dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
