<mxfile host="app.diagrams.net">
  <diagram id="nanoclaw-overview" name="NanoClaw AWS Architecture">
    <mxGraphModel dx="2800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- background -->
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2000" height="1000" as="geometry" />
        </mxCell>

        <!-- title -->
        <mxCell id="title" value="&lt;b&gt;NanoClaw — AWS Architecture (WhatsApp Cloud API)&lt;/b&gt;&lt;br&gt;Logical architecture | 2026-07-20 | v2 — migrated from Baileys" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- edge legend -->
        <mxCell id="legend1" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#232F3E;" edge="1" parent="1">
          <mxGeometry x="1480" y="35" width="60" height="1" relative="1" as="geometry">
            <mxPoint x="1480" y="40" as="sourcePoint" />
            <mxPoint x="1540" y="40" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend1label" value="Live / wired data flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="28" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#232F3E;" edge="1" parent="1">
          <mxGeometry x="1480" y="60" width="60" height="1" relative="1" as="geometry">
            <mxPoint x="1480" y="65" as="sourcePoint" />
            <mxPoint x="1540" y="65" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend2label" value="Planned / not yet wired" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="53" width="220" height="24" as="geometry" />
        </mxCell>

        <!-- EC2 logical box -->
        <mxCell id="ec2box" value="EC2 Instance (single host, publicly reachable)" style="fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#232F3E;fontSize=13;whiteSpace=wrap;html=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="600" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ec2subnote" value="Public IP/domain — TLS terminated on-instance (nginx + certbot), proxies to webhook server (:3000)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5A6C86;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="163" width="580" height="20" as="geometry" />
        </mxCell>

        <!-- WhatsApp Cloud API (external, non-AWS) -->
        <mxCell id="whatsapp" value="" style="sketch=0;shape=mxgraph.aws4.internet_alt2;fillColor=#232F3D;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="whatsappLabel" value="WhatsApp Cloud API&lt;br&gt;(Meta — external, non-AWS)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="312" width="178" height="40" as="geometry" />
        </mxCell>

        <!-- NanoClaw Host process (EC2) -->
        <mxCell id="host" value="" style="sketch=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="hostLabel" value="NanoClaw Host&lt;br&gt;(Node process + webhook receiver)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="312" width="178" height="34" as="geometry" />
        </mxCell>

        <!-- Agent Docker containers -->
        <mxCell id="containers" value="" style="sketch=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.containers;fillColor=#ED7100;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="containersLabel" value="Agent Docker containers&lt;br&gt;(per agent group)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="312" width="198" height="34" as="geometry" />
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrock" value="" style="sketch=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1020" y="230" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bedrockLabel" value="Amazon Bedrock&lt;br&gt;(planned inference target)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="312" width="198" height="34" as="geometry" />
        </mxCell>

        <!-- EBS volume (attached storage — lives inside the EC2 instance boundary) -->
        <mxCell id="ebs" value="" style="sketch=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_block_store;fillColor=#7AA116;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ebsLabel" value="EBS Volume (attached)&lt;br&gt;4x Chroma vector collections +&lt;br&gt;SQLite: v2.db, inbound.db, outbound.db" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="662" width="258" height="56" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="" style="sketch=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1020" y="580" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3Label" value="S3&lt;br&gt;Uploads, logs, generated/processed images" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="662" width="258" height="40" as="geometry" />
        </mxCell>

        <!-- Edge: WhatsApp Cloud API -> Host (inbound webhook) -->
        <mxCell id="e1" value="inbound webhook (HTTPS, signed)&lt;br&gt;POST /webhook/whatsapp-cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="whatsapp" target="host" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Host -> Containers -->
        <mxCell id="e2" value="routes messages / wakes container" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="host" target="containers" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Containers -> Bedrock (planned, dashed) -->
        <mxCell id="e3" value="AI inference calls (planned)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;verticalAlign=bottom;" edge="1" source="containers" target="bedrock" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Containers -> EBS (local attached-volume I/O, both inside the instance) -->
        <mxCell id="e4" value="local I/O — read/write&lt;br&gt;Chroma + SQLite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;align=right;verticalAlign=top;" edge="1" source="containers" target="ebs" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Containers -> S3 -->
        <mxCell id="e5" value="uploads / logs / images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=11;align=left;verticalAlign=top;" edge="1" source="containers" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
